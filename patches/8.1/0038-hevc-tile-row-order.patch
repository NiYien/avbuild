+    ff_hevc_save_states(lc, pps, ctb_addr_ts + 1);
+    ff_hevc_hls_filters(lc, l, pps, x_ctb, y_ctb, ctb_size);
+
+    /* The return value of hls_coding_quadtree() tells whether the slice goes on */
+    return ret;
+
+fail:
+    l->tab_slice_address[ctb_addr_rs] = -1;
+    return ret;
